{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.agentposhq.safepay/check",
  "title": "SafePay Check",
  "description": "Judges a payment (PayPal, PYUSD or USDC) before an AI agent makes it. Signed proof. Moves no money.",
  "repository": {
    "url": "https://github.com/NovaCorpAI/safepay",
    "source": "github"
  },
  "websiteUrl": "https://safepay.agentposhq.com/connect",
  "version": "0.8.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://safepay.agentposhq.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer spk_... agent key, free at https://safepay.agentposhq.com/connect",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://safepay.agentposhq.com/static/seal-512.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ]
}
