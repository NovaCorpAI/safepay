# --- PayPal sandbox (required for real payouts; without it SafePay runs simulated) ---
# Create a sandbox app at developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Sandbox host. Never set this to the live host (api-m.paypal.com) for the demo.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Nebius Token Factory (OpenAI-compatible) for the intent/anomaly reasoner ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Tavily web search for live merchant verification ---
TAVILY_API_KEY=

# --- Signs each audit record (HMAC-SHA256). Leave blank for integrity-only records. ---
SAFEPAY_SIGNING_KEY=

# --- LangSmith tracing (optional, off unless both are set) ---
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=safepay

# Optional: durable, shared state (audit chain, spend ledger, approvals).
# Run supabase/schema.sql once; use the service role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
